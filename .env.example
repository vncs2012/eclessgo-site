API_BASE_URL=http://127.0.0.1:8000/api/v1
# API_BASE_URL is server-only. Do not duplicate it as NEXT_PUBLIC_API_URL:
# public pages call the Web BFF and do not need the internal API URL.
# URL canônica do site público. Em produção, use o domínio HTTPS publicado;
# ela é usada por sitemap.xml, robots.txt e metadados compartilhados.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# URL do painel administrativo. Em produção, não deixe apontando para localhost.
NEXT_PUBLIC_PANEL_URL=http://localhost:3000
NEXT_PUBLIC_APP_CTA_URL=/#app

# Set true in a production process to fail build/start when any production URL
# or mobile-link credential is absent, local, malformed, or a placeholder.
ECLESSGO_RELEASE_STRICT=false

# Server-only credentials used to generate /.well-known/* at request time.
# Keep empty locally; before production fill them with real release values.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.eclessgo.app
ANDROID_PACKAGE_NAME=com.eclessgo.app
ANDROID_SHA256_CERT_FINGERPRINT=
# Origin HTTPS do CDN/S3 que hospeda logos e capas públicas (opcional).
# Não use wildcard; informe apenas a origem, por exemplo https://cdn.example.com.
NEXT_PUBLIC_MEDIA_ORIGIN=

# Uploads do cadastro publico passam pelo proxy /api/public/register-church/upload
# e usam o storage configurado apenas no backend.

# Product analytics is forwarded by eclessgo-api from /analytics/events.
# Do not place PostHog or Mixpanel credentials in the public web env.

# W3C trace propagation from browser -> Next BFF -> API. Keep disabled locally
# unless the API has an approved OTLP backend and the trace cost is bounded.
NEXT_PUBLIC_OTEL_ENABLED=false

# Optional Sentry observability. Keep disabled locally unless you have a real DSN.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=

# Public information assistant: abuse and spend protection.
# Shared counters/cache across instances (Upstash Redis via Vercel Marketplace).
# Without these, limits are kept in memory per function instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
ASSISTANT_RATE_LIMIT_IP_PER_MINUTE=5
ASSISTANT_RATE_LIMIT_IP_PER_HOUR=30
ASSISTANT_RATE_LIMIT_SLUG_PER_HOUR=120
# Global daily ceiling; when reached the endpoint answers 503 ASSISTANT_UNAVAILABLE.
ASSISTANT_GLOBAL_DAILY_LIMIT=1000
ASSISTANT_RESPONSE_CACHE_TTL_SECONDS=300
