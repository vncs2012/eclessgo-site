API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# URL canônica do site público. Em produção, use o domínio HTTPS publicado;
# ela é usada por sitemap.xml, robots.txt e metadados compartilhados.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# URL do painel administrativo. Em produção, não deixe apontando para localhost.
NEXT_PUBLIC_PANEL_URL=http://localhost:3000
NEXT_PUBLIC_APP_CTA_URL=/#app
NEXT_PUBLIC_LEGAL_TERMS_VERSION=2026-07-12
NEXT_PUBLIC_LEGAL_PRIVACY_VERSION=2026-07-12
# Origin HTTPS do CDN/S3 que hospeda logos e capas públicas (opcional).
# Não use wildcard; informe apenas a origem, por exemplo https://cdn.example.com.
NEXT_PUBLIC_MEDIA_ORIGIN=

# Uploads do cadastro publico passam pelo proxy /api/public/register-church/upload
# e usam o storage configurado apenas no backend.

# Product analytics is forwarded by eclessgo-api from /analytics/events.
# Do not place PostHog or Mixpanel credentials in the public web env.

# W3C trace propagation from browser -> Next BFF -> API. Keep disabled locally
# unless the API has an approved OTLP backend and the trace cost is bounded.
NEXT_PUBLIC_OTEL_ENABLED=false

# Optional Sentry observability. Keep disabled locally unless you have a real DSN.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
